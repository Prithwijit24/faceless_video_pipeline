# Copy this file to .env and fill in your values:
#   cp .env.example .env
# The pipeline and every step script load .env automatically. Keys you
# already export in your shell (or set as GitHub Actions secrets) always
# win over .env. .env itself is gitignored - never commit real keys.

# --- required ---
LLM_API_KEY=your-agnes-key            # script LLM (Groq key works as fallback)
CHANNEL_ID=mythology                  # must match an id in config/channels.yaml
# VIDEO_INDEX=1                       # label only, used in filenames/logs

# --- optional ---
PEXELS_API_KEY=your-pexels-key
HORDE_IMAGE_API_KEY=your-horde-key
FREESOUND_API_TOKEN=your-freesound-token
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# optional - give each channel its own Telegram bot for local runs
MYTHOLOGY_TELEGRAM_BOT_TOKEN=
HORROR_TELEGRAM_BOT_TOKEN=
SPACE_TELEGRAM_BOT_TOKEN=
PSYCHOLOGY_TELEGRAM_BOT_TOKEN=

# optional - LLM provider/model overrides
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_THINKING=1
# LLM_MAX_TOKENS=4096
# SCRIPT_RETRIES=3
# JSON_RETRIES=3

# optional - voiceover/subtitle tuning (defaults are already good)
# TTS_VOICE=
# TTS_RATE=
# TTS_PITCH=+10Hz
# WHISPER_MODEL=small
# WHISPER_LANGUAGE=en

# optional - misc
# HORDE_IMAGE_MODEL=
# HORDE_TIMEOUT=600
# FREESOUND_QUERY=
# HISTORY_DIR=

# Safety is always enabled and cannot be disabled. Visuals are screened locally
# with NudeNet; the pipeline fails closed if the detector is unavailable.
# Optional tuning:
# VISUAL_SAFETY_THRESHOLD=0.40
# VISUAL_RETRIES=3
# VISUAL_REJECT_HUMANS=1
# VOICE_VOLUME=1.8
# TARGET_LUFS=-14
